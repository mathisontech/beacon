# ===========================================
# Beacon API Environment Configuration
# ===========================================

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_URL=http://localhost:4000

# ===========================================
# Database (PostgreSQL + PostGIS via Supabase)
# ===========================================
# Development (local Docker)
DATABASE_URL=postgresql://beacon:beacon_dev_password@localhost:5432/beacon_db

# Production (Supabase - use pooled connection)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:6543/postgres?pgbouncer=true

# ===========================================
# Redis (Upstash for production)
# ===========================================
# Development (local Docker)
REDIS_URL=redis://localhost:6379

# Production (Upstash - use TLS)
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Generate secure secrets for production
# Run: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# CORS Configuration
# ===========================================
# Development: allow all
CORS_ORIGINS=*

# Production: comma-separated allowed origins
# CORS_ORIGINS=https://admin.beacon-emergency.com,https://beacon-emergency.com

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# Password Hashing
# ===========================================
BCRYPT_ROUNDS=12

# ===========================================
# File Storage (Cloudflare R2)
# ===========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beacon-storage
R2_PUBLIC_URL=

# Storage paths
STORAGE_MAP_TILES_PATH=map-tiles
STORAGE_DATASETS_PATH=datasets
STORAGE_MEDIA_PATH=media
STORAGE_DEMOS_PATH=demos

# ===========================================
# SMS Notifications (Twilio)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY=
EMAIL_FROM=alerts@beacon-emergency.com

# ===========================================
# Push Notifications (Expo)
# ===========================================
EXPO_ACCESS_TOKEN=

# ===========================================
# External APIs
# ===========================================
# National Weather Service (no key needed, but set base URL)
NWS_API_BASE_URL=https://api.weather.gov

# OpenRouteService (for routing)
OPENROUTE_API_KEY=

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=info
# SENTRY_DSN=

# ===========================================
# Feature Flags
# ===========================================
ENABLE_MESH_NETWORK=false
ENABLE_SMS_ALERTS=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EAS_INTEGRATION=false
