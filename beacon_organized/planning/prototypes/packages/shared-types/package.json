{
  "name": "@beacon/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Beacon applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./users": {
      "types": "./dist/users.d.ts",
      "import": "./dist/users.js",
      "require": "./dist/users.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js",
      "require": "./dist/status.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "import": "./dist/tags.js",
      "require": "./dist/tags.js"
    },
    "./alerts": {
      "types": "./dist/alerts.d.ts",
      "import": "./dist/alerts.js",
      "require": "./dist/alerts.js"
    },
    "./groups": {
      "types": "./dist/groups.d.ts",
      "import": "./dist/groups.js",
      "require": "./dist/groups.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  },
  "keywords": [
    "beacon",
    "types",
    "typescript"
  ],
  "license": "UNLICENSED",
  "private": true
}
